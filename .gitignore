# ===== Python 缓存 / 编译产物 =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 虚拟环境 =====
.venv/
venv/

# ===== 环境变量 / 密钥 =====
.env
.env.*
!.env.example

# ===== 本地数据库文件 =====
ip2region.xdb
ip2region_v4.xdb

# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
.idea/
.vscode/

# ===== 运行产物 / 临时目录 =====
temp/
logs/
*.stackdump
.playwright-mcp/

# ===== 验证码样本仓库归档（主动提交，不忽略） =====
# captcha_samples/ 由 CI 每天从 logs/captcha_archive/ 复制并提交到仓库，用于长期保存训练数据。
# 注意：不忽略该目录，但忽略临时训练输出。
!captcha_samples/
captcha_samples/**/debug/
captcha_samples/**/*.tmp

# ===== 本地记忆（不入库） =====
memory/

# ===== 项目本地文档（不入库） =====
AGENTS.md
CLAUDE.md
